# CompliFine API — Elysia service
# Copy to Railway variables on the API service (not web, not console).
# Local: keep using the repo-root .env (`cp ../../.env.example ../../.env`).

# --- required ---

# Railway: reference the Postgres plugin by its service name.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://complifine:complifine@localhost:5434/complifine

# At least 16 characters. Never reuse the example value in production.
JWT_SECRET=complifine-dev-jwt-secret-change-me

# Volume mount on Railway: /data/storage
STORAGE_ROOT=/data/storage

# --- platform (Railway injects PORT; do not set 3311 on Railway) ---

# PORT=
API_PORT=3311
NODE_ENV=production

# Pre-deploy already runs migrations (`apps/api/railway.toml`).
# false = do not migrate again on every replica restart.
RUN_MIGRATIONS=false

# HTTPS hosts: omit this (cookies are Secure when NODE_ENV=production).
# Local HTTP / docker compose: COOKIE_SECURE=false
# COOKIE_SECURE=false

# --- operator seed (required on Railway; pre-deploy runs db:seed) ---

OPERATOR_EMAIL=operator@complifine.local
OPERATOR_PASSWORD=changeme-operator

# --- AI (embeddings + /ask; ingest works without these) ---

OPENAI_API_KEY=
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Snappy producer chat. Leave AGENT_MODEL for Run Audit / capture.
CHAT_MODEL=gpt-4.1
# CHAT_MAX_STEPS=8
AGENT_MODEL=gpt-5

# --- optional ---

FETCH_USER_AGENT="CompliFine/0.1 (compliance knowledge base; +mailto:you@example.com)"
# LOG_LEVEL=info
# LOG_FORMAT=json

# Notification emails (Resend). Leave unset until the domain is verified.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=CompliFine <notifications@your-verified-domain>
# Public web origin for links in emails.
# APP_BASE_URL=https://complifine.com

# --- PDF parsing ---

POPPLER_PATH=/usr/bin/pdftotext