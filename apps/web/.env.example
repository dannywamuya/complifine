# CompliFine web — producer app + marketing (port 3000)
# Copy these onto the Railway *web* service. Do not put DATABASE_URL or
# JWT_SECRET here; the browser never talks to Postgres.

# --- required at runtime ---

# Private URL of the API service. Use the API service's exact name.
# Docker Compose:  http://api:3311
# Local next dev:  http://127.0.0.1:3311
# Railway:
API_PROXY_TARGET=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}

# Browser calls stay on this origin so JWT cookies are first-party.
# Inlined at `next build` — default is already /api if unset.
NEXT_PUBLIC_API_URL=/api

# --- platform (Railway injects PORT) ---

# PORT=
HOSTNAME=0.0.0.0
NODE_ENV=production

# --- marketing only (this app, not the console) ---

# Calendar link on /demo. Leave unset to hide it.
# NEXT_PUBLIC_CAL_URL=https://cal.com/you
