# CompliFine console — operator admin (port 3001)
# Copy these onto the Railway *console* service. Same proxy shape as web,
# different origin, no marketing calendar, no producer signup.

# --- required at runtime ---

# Private URL of the API service. Use the API service's exact name.
# Docker Compose:  http://api:3311
# Local next dev:  http://127.0.0.1:3311
# Railway:
API_PROXY_TARGET=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}

# Browser calls stay on this origin so operator JWT cookies are first-party.
# Must not point at the producer web URL.
NEXT_PUBLIC_API_URL=/api

# --- platform (Railway injects PORT) ---

# PORT=
HOSTNAME=0.0.0.0
NODE_ENV=production

# Sign in as OPERATOR_EMAIL / OPERATOR_PASSWORD from the API service
# (created by `bun run db:seed` on the API, not here).
