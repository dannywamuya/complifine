# Local all-in-one for `bun run bootstrap`, `bun run api`, and CLI tools.
# Railway: do not paste this file onto every service. Use the per-app files:
#   apps/api/.env.example
#   apps/web/.env.example
#   apps/console/.env.example   (operator admin)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches infra/docker-compose.yml. Port 5434 avoids colliding with any other
# local Postgres you may already be running.
DATABASE_URL=postgres://complifine:complifine@localhost:5434/complifine

# ---------------------------------------------------------------------------
# Source acquisition
# ---------------------------------------------------------------------------
STORAGE_ROOT=./storage
FETCH_USER_AGENT="CompliFine/0.1 (compliance knowledge base; +mailto:you@example.com)"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AGENT_MODEL=gpt-5

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
JWT_SECRET=complifine-dev-jwt-secret-change-me
OPERATOR_EMAIL=operator@complifine.local
OPERATOR_PASSWORD=changeme-operator
API_PORT=3311
# PORT=3311
# COOKIE_SECURE=false
