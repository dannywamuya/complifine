# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches infra/docker-compose.yml. Port 5434 avoids colliding with any other
# local Postgres you may already be running.
DATABASE_URL=postgres://complifine:complifine@localhost:5434/complifine

# ---------------------------------------------------------------------------
# Source acquisition
# ---------------------------------------------------------------------------
# Where downloaded official documents are preserved byte-for-byte. Relative
# paths resolve from the repo root.
STORAGE_ROOT=./storage

# Sent on every request to documents.globalgap.org. Identifying yourself is
# both polite and makes it easier for them to reach you if fetching is a
# problem. Replace the contact address with your own.
FETCH_USER_AGENT="CompliFine/0.1 (compliance knowledge base; +mailto:you@example.com)"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Required for embeddings (M6) and the agent (M7). Ingestion, reconciliation
# and publication (M0-M5) run entirely without it.
OPENAI_API_KEY=

# Overridable so you can point at Azure OpenAI or a compatible gateway.
# OPENAI_BASE_URL=            # only for an OpenAI-compatible proxy; leave unset for api.openai.com

# The embedding model determines the pgvector column dimension. Changing it
# requires a migration; see docs/RAG.md before you do.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Generation model for the compliance agent.
AGENT_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
JWT_SECRET=complifine-dev-jwt-secret-change-me
OPERATOR_EMAIL=operator@complifine.local
OPERATOR_PASSWORD=changeme-operator
# Optional calendar link shown under the Book a Demo form.
# NEXT_PUBLIC_CAL_URL=

NEXT_PUBLIC_API_URL=/api
# User app is :3000, operator console is :3001. Both proxy /api to the Elysia server.
# Server Components cannot fetch a relative URL; they use this origin instead.
# API_PROXY_TARGET=http://127.0.0.1:3311
API_PORT=3311
# Docker/Railway inject PORT; the API listens on it when set.
# PORT=3311
# COOKIE_SECURE=false   # local HTTP (docker compose). Omit on HTTPS hosts.
